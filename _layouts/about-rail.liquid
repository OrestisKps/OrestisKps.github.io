---
layout: default
---

{% comment %}
  Two-column homepage: identity rail + content column (design 1c, trimmed).
  Styles live in _sass/_rail.scss. All colours come from --global-* variables
  so the light/dark toggle keeps working.

  The rail carries no page nav: the navbar in _includes/header.liquid is the
  single source of navigation, so the links are not duplicated here.
{% endcomment %}

<div class="rail-page">
  <aside class="rail">
    {% if page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      {%
        include figure.liquid
        loading="eager"
        path=profile_image_path
        class="rail-photo"
        sizes="340px"
        alt=page.profile.image_alt
        cache_bust=true
      %}
    {% endif %}

    <div class="rail-identity">
      <h1 class="rail-name">
        {%- if site.title == 'blank' -%}
          {{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}
        {%- else -%}
          {{ site.title }}
        {%- endif -%}
      </h1>
      {% if page.affiliation %}
        <p class="rail-affiliation">{{ page.affiliation }}</p>
      {% endif %}
      {% if page.profile.address %}
        <div class="rail-address">{{ page.profile.address }}</div>
      {% endif %}
    </div>

    <hr class="rail-rule">

    {% comment %}
      Icon links, read from _data/socials.yml so there is a single source of
      truth. Font Awesome covers email and LinkedIn; Academicons covers Google
      Scholar and ORCID. Both stylesheets are already loaded in head.liquid.
      Each icon carries an aria-label and a title, since the glyph alone is
      not accessible.
    {% endcomment %}
    {% if page.social %}
      <div class="rail-social">
        {% if site.data.socials.email %}
          <a href="mailto:{{ site.data.socials.email }}" title="Email" aria-label="Email">
            <i class="fa-solid fa-envelope"></i>
          </a>
        {% endif %}
        {% if site.data.socials.scholar_userid %}
          <a
            href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
            target="_blank"
            rel="noopener"
            title="Google Scholar"
            aria-label="Google Scholar"
          >
            <i class="ai ai-google-scholar"></i>
          </a>
        {% endif %}
        {% if site.data.socials.orcid_id %}
          <a
            href="https://orcid.org/{{ site.data.socials.orcid_id }}"
            target="_blank"
            rel="noopener"
            title="ORCID"
            aria-label="ORCID"
          >
            <i class="ai ai-orcid"></i>
          </a>
        {% endif %}
        {% if site.data.socials.linkedin_username %}
          <a
            href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}"
            target="_blank"
            rel="noopener"
            title="LinkedIn"
            aria-label="LinkedIn"
          >
            <i class="fa-brands fa-linkedin"></i>
          </a>
        {% endif %}
      </div>
    {% endif %}

  </aside>

  <main class="rail-content">
    <section class="rail-section">{{ content }}</section>
  </main>
</div>
